+    private ArrayList<Models.VideoItem> diversifyByChannel(List<Models.VideoItem> source) {
+        ArrayList<Models.VideoItem> pool = new ArrayList<>(source);
+        ArrayList<Models.VideoItem> mixed = new ArrayList<>();
+        String last = "";
+        while (!pool.isEmpty()) {
+            int pick = 0;
+            for (int i = 0; i < pool.size(); i++) {
+                String c = safeLower(pool.get(i).channelTitle);
+                if (last.isEmpty() || !c.equals(last)) { pick = i; break; }
+            }
+            Models.VideoItem v = pool.remove(pick);
+            mixed.add(v);
+            last = safeLower(v.channelTitle);
+        }
+        return mixed;
+    }
+
+    private boolean matchesCategory(Models.VideoItem v, String category) {
+        if (category == null || category.isEmpty() || "Recommended".equals(category) || "New Videos".equals(category)) return true;
+        String title = safeLower(v.title);
+        String channel = safeLower(v.channelTitle);
+        String hay = title + " " + channel;
+
+        if ("Stories & Cartoons".equals(category)) {
+            return containsAny(channel, "bluey", "peppa pig", "curious george", "hey duggee", "storybots", "pbs kids")
+                    || containsAny(title, "story", "stories", "cartoon", "episode", "movie", "adventure");
+        }
+        if ("Animals".equals(category)) {
+            return containsAny(channel, "wild kratts", "brave wilderness", "national geographic", "nat geo", "bbc earth", "octonauts")
+                    || containsAny(hay, "animal", "wildlife", "ocean", "sea ", "dinosaur", "shark", "whale", "lion", "tiger", "elephant", "bird", "insect", "creature");
+        }
+        if ("Science".equals(category)) {
+            return containsAny(channel, "scishow kids", "science max", "operation ouch", "smartereveryday", "action lab", "kurzgesagt", "ted-ed", "crash course kids", "mark rober")
+                    || containsAny(hay, "science", "experiment", "physics", "chemistry", "biology", "body", "brain", "energy", "planet", "how does", "why does");
+        }
+        if ("Engineering".equals(category)) {
+            return containsAny(channel, "mark rober", "smartereveryday", "action lab")
+                    || containsAny(hay, "engineering", "engineer", "machine", "robot", "build", "invention", "mechanic", "technology", "rocket");
+        }
+        if ("Space".equals(category)) {
+            return containsAny(hay, "space", "planet", "solar system", "moon", "mars", "rocket", "astronaut", "galaxy", "universe", "star ", "stars", "black hole", "satellite");
+        }
+        if ("History".equals(category)) {
+            return containsAny(channel, "horrible histories")
+                    || containsAny(hay, "history", "historic", "ancient", "roman", "egypt", "medieval", "victorian", "war ", "century", "civilization", "civilisation", "king ", "queen ");
+        }
+        if ("Numbers & Reading".equals(category)) {
+            return containsAny(channel, "numberblocks", "alphablocks")
+                    || containsAny(hay, "number", "count", "math", "maths", "addition", "subtract", "alphabet", "phonics", "reading", "letter", "word ", "spelling");
+        }
+        if ("Art & Making".equals(category)) {
+            return containsAny(channel, "art for kids hub", "maddie moate")
+                    || containsAny(hay, "draw", "drawing", "art ", "paint", "craft", "make ", "making", "diy", "create", "how to make");
+        }
+        if ("Move & Dance".equals(category)) {
+            return containsAny(channel, "danny go")
+                    || containsAny(hay, "dance", "move ", "movement", "exercise", "workout", "sing along", "song");
+        }
+        return true;
+    }
