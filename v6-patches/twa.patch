+package com.kidsvideo.app;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.graphics.Color;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.view.Gravity;
+import android.view.ViewGroup;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import com.google.androidbrowserhelper.trusted.TwaLauncher;
+
+/**
+ * Small native trampoline that launches the hosted YouTube player as a Trusted Web Activity.
+ * The actual player is rendered/networked by the device browser (normally Chrome), not WebView.
+ */
+public final class TwaPlaybackActivity extends Activity {
+    public static final String EXTRA_VIDEO_ID = "video_id";
+    public static final String EXTRA_TITLE = "title";
+    public static final String RESULT_WATCH_SECONDS = "watch_seconds";
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private TwaLauncher twaLauncher;
+    private boolean launched;
+    private boolean browserTookFocus;
+    private boolean finished;
+    private long launchElapsed;
+
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        getWindow().setStatusBarColor(Color.BLACK);
+        getWindow().setNavigationBarColor(Color.BLACK);
+        buildLoadingScreen();
+
+        String videoId = getIntent().getStringExtra(EXTRA_VIDEO_ID);
+        if (videoId == null || !videoId.matches("^[A-Za-z0-9_-]{11}$")) {
+            finishWithResult(0);
+            return;
+        }
+
+        Uri url = new Uri.Builder()
+                .scheme("https")
+                .authority("davidamerson.github.io")
+                .path("kids-player.html")
+                .appendQueryParameter("v", videoId)
+                .appendQueryParameter("profile", AppProfile.isSon() ? "son" : "daughter")
+                .build();
+
+        launchElapsed = SystemClock.elapsedRealtime();
+        handler.post(() -> {
+            if (isFinishing()) return;
+            try {
+                twaLauncher = new TwaLauncher(this);
+                launched = true;
+                twaLauncher.launch(url);
+            } catch (Throwable t) {
+                // Last-resort browser intent. It still keeps playback in the browser/VPN path, never WebView.
+                try {
+                    Intent browser = new Intent(Intent.ACTION_VIEW, url);
+                    browser.addCategory(Intent.CATEGORY_BROWSABLE);
+                    launched = true;
+                    startActivity(browser);
+                } catch (Throwable ignored) {
+                    finishWithResult(0);
+                }
+            }
+        });
+    }
+
+    private void buildLoadingScreen() {
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setGravity(Gravity.CENTER);
+        root.setBackgroundColor(Color.BLACK);
+        ProgressBar progress = new ProgressBar(this);
+        TextView text = new TextView(this);
+        text.setText("Opening video…");
+        text.setTextColor(Color.WHITE);
+        text.setTextSize(18f);
+        text.setPadding(0, 24, 0, 0);
+        root.addView(progress, new LinearLayout.LayoutParams(72, 72));
+        root.addView(text, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        setContentView(root);
+    }
+
+    @Override protected void onPause() {
+        super.onPause();
+        if (launched) browserTookFocus = true;
+    }
+
+    @Override protected void onResume() {
+        super.onResume();
+        if (launched && browserTookFocus && !finished) {
+            // Returning from the browser/TWA. Give Android a moment so transient focus changes do not close early.
+            handler.postDelayed(() -> {
+                if (!isFinishing() && browserTookFocus) {
+                    long seconds = Math.max(0, (SystemClock.elapsedRealtime() - launchElapsed) / 1000L);
+                    finishWithResult(seconds);
+                }
+            }, 300);
+        }
+    }
+
+    private void finishWithResult(long seconds) {
+        if (finished) return;
+        finished = true;
+        Intent result = new Intent();
+        result.putExtra(RESULT_WATCH_SECONDS, seconds);
+        setResult(RESULT_OK, result);
+        finish();
+    }
+
+    @Override public void onBackPressed() {
+        finishWithResult(Math.max(0, (SystemClock.elapsedRealtime() - launchElapsed) / 1000L));
+    }
+
+    @Override protected void onDestroy() {
+        handler.removeCallbacksAndMessages(null);
+        if (twaLauncher != null) {
+            try { twaLauncher.destroy(); } catch (Throwable ignored) {}
+        }
+        super.onDestroy();
+    }
+}
