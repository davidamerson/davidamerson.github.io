+    private void refreshCategoryStyles() {
+        if (categoryRow == null) return;
+        for (int i = 0; i < categoryRow.getChildCount(); i++) {
+            View child = categoryRow.getChildAt(i);
+            if (!(child instanceof Button)) continue;
+            Button b = (Button) child;
+            boolean active = "home".equals(mode) && String.valueOf(b.getTag()).equals(selectedCategory);
+            GradientDrawable bg = new GradientDrawable();
+            bg.setCornerRadius(dp(18));
+            bg.setColor(active ? Color.rgb(225, 38, 58) : Color.rgb(43, 45, 52));
+            bg.setStroke(dp(1), active ? Color.rgb(255, 80, 95) : Color.rgb(82, 85, 96));
+            b.setBackground(bg);
+            b.setTextColor(Color.WHITE);
+            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
+                    ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+            lp.setMargins(0, 0, dp(8), 0);
+            b.setLayoutParams(lp);
+        }
+    }
+
+    private static boolean containsAny(String hay, String... needles) {
+        String h = safeLower(hay);
+        for (String n : needles) if (n != null && !n.isEmpty() && h.contains(n.toLowerCase(Locale.US))) return true;
+        return false;
+    }
+
+    private static String safeLower(String s) {
+        return s == null ? "" : s.toLowerCase(Locale.US);
+    }
