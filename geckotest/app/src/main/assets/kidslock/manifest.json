{
  "manifest_version": 2,
  "name": "Kids Lock",
  "version": "1.0",
  "description": "Restricts YouTube watch pages to the current video player.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kidslock@example.com"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
